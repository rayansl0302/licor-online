{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/licor-rayan-painel", "destination": "/index.html" },
    { "source": "/licor-rayan-painel/", "destination": "/index.html" },
    {
      "source": "/((?!assets/|sw\\.js$|workbox-[^/]+$|manifest\\.webmanifest$|.*\\.(png|svg|ico|webmanifest)$).*)",
      "destination": "/index.html"
    }
  ]
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Só entra se estiver logado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin: e-mail deve conter "rayan" (maiúsc/minúsc)
    // Ex.: rayan@gmail.com, contato.rayan@empresa.com
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*[rR][aA][yY][aA][nN].*');
    }

    function isValidPublicOrder() {
      let data = request.resource.data;
      return data.origem == 'cliente-publico'
        && !('criadoPor' in data)
        && data.clienteNome is string
        && data.clienteNome.size() >= 2
        && data.clienteNome.size() <= 120
        && data.marcaId is string
        && data.marcaId.size() >= 2
        && data.marcaId.size() <= 80
        && data.marcaNome is string
        && data.marcaNome.size() >= 2
        && data.marcaNome.size() <= 120
        && data.observacao is string
        && data.observacao.size() <= 500
        && data.total is number
        && data.total >= 0
        && data.total <= 50000
        && data.concluido == false
        && data.cancelado == false
        && data.itens is list
        && data.itens.size() > 0
        && data.itens.size() <= 80;
    }

    // Pedidos — admin gerencia; cliente público só pode criar
    match /pedidos/{pedidoId} {
      allow read: if isAdmin();
      allow create: if (isAdmin()
          && request.resource.data.criadoPor == request.auth.uid)
        || isValidPublicOrder();
      allow update, delete: if isAdmin();
    }

    // Dados PIX e preferências — cada admin só acessa o próprio documento
    match /usuarios/{userId} {
      allow read, write: if isAdmin() && request.auth.uid == userId;
    }

    // Catálogo de licores — leitura pública para o link de pedido
    match /config/catalogo {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bloqueia qualquer outra coleção
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
